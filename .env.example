# ===== AI Research Terminal — 环境变量模板 =====
# 复制此文件为 .env 并填入实际值
# .env 不提交 Git

# ===== 运行环境 =====
APP_ENV=production
APP_DEBUG=false
ADAPTIVE_API_RELOAD=false
APP_SECRET_KEY=change-me-in-production

# ===== 数据库 =====
# Database and application log paths come from the workspace config/runtime.env.

# ===== Codex CLI (default) =====
AI_PRIMARY_PROVIDER=codex_cli
AI_REVIEW_PROVIDER=codex_cli
CODEX_MODEL=gpt-5.6-terra
CODEX_CLI_PATH=codex
# Set this when the backend runs under a service account whose home differs
# from the Windows account used by `codex login`.
# CODEX_HOME=C:/Users/your-name/.codex
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=120
CODEX_MAX_OUTPUT_TOKENS=2000
CODEX_ANALYSIS_MAX_CONCURRENCY=2

# Optional legacy/manual provider only. The scheduled closed loop never uses it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Shared model defaults come from config/runtime.env:
# AI_DEEP_MODEL and AI_FAST_MODEL.

# ===== OpenAI 兼容接口 (备用) =====
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 数据源 =====
TUSHARE_TOKEN=your-tushare-token-here
# HiThink Financial API（同花顺官方 A 股金融数据服务）；只在用户环境设置真实值
HITHINK_FINANCE_API_KEY=
HITHINK_BASE_URL=https://fuyao.aicubes.cn
HITHINK_TIMEOUT_SECONDS=8
HITHINK_RETRY_ATTEMPTS=2
HITHINK_MIN_INTERVAL_SECONDS=0.25
HITHINK_FAILURE_THRESHOLD=3
HITHINK_COOLDOWN_SECONDS=60
# Optional comma-separated shadow canary matrix (max 20 A-share codes)
HITHINK_CANARY_CODES=600519.SH,000001.SZ,300750.SZ,688981.SH,002594.SZ,601318.SH,600000.SH,300015.SZ
HITHINK_SYMBOL_MODE=shadow
HITHINK_VALUATION_MODE=shadow
HITHINK_SPECIAL_MODE=shadow
HITHINK_DAILY_MODE=validator
HITHINK_FINANCIAL_MODE=validator
HITHINK_REALTIME_MODE=shadow
TICKFLOW_API_KEY=
TICKFLOW_BASE_URL=https://api.tickflow.org
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FINNHUB_API_KEY=your-finnhub-key
FMP_API_KEY=your-fmp-key
TWELVEDATA_API_KEY=your-twelvedata-key
POLYGON_API_KEY=your-polygon-key

# 每日候选池默认从同花顺/东财/腾讯真实数据发现；本地 SQLite 只作缓存和兜底。
SCANNER_FULL_UNIVERSE_COUNT=6000
SCANNER_TECHNICAL_SHORTLIST_COUNT=300
SCANNER_AI_PRESELECT_COUNT=20
SCANNER_AI_DEEP_ANALYSIS_N=5
TRADINGAGENTS_EXECUTION_MODE=isolated
TRADINGAGENTS_ANALYSIS_TIMEOUT_SECONDS=240
TRADINGAGENTS_MAX_CONCURRENCY=2
TRADINGAGENTS_ANALYSTS=market,news,fundamentals
REMOTE_MARKET_DISCOVERY_ENABLED=true
REMOTE_MARKET_CANDIDATE_LIMIT=300
REMOTE_MARKET_TIMEOUT_SECONDS=12
EASTMONEY_MIN_INTERVAL_SECONDS=1.5
EASTMONEY_JITTER_SECONDS=0.5
EASTMONEY_FAILURE_THRESHOLD=2
EASTMONEY_COOLDOWN_SECONDS=900
REMOTE_MARKET_LOCAL_FALLBACK_COUNT=6000
PAPER_EXECUTION_QUOTE_ATTEMPTS=8
PAPER_EXECUTION_QUOTE_RETRY_DELAY_SECONDS=1.25
PAPER_EXPLORATION_ENABLED=true
LIVE_EXPLORATION_ENABLED=false
PAPER_EXPLORATION_POSITION_PCT=0.02
PAPER_EXPLORATION_MAX_POSITION_PCT=0.03
PAPER_EXPLORATION_MAX_TOTAL_PCT=0.05
PAPER_EXPLORATION_MAX_ENTRIES=1
PAPER_EXPLORATION_CONFIRMATION_DAYS=3
PAPER_EXPLORATION_MAX_HOLDING_DAYS=5
PAPER_EXPLORATION_STOP_LOSS_PCT=4.0
MAX_POSITION_PCT=0.20
STOCK_SKILL_BRIDGE_ENABLED=true
STOCK_SKILL_MAX_QUOTE_COUNT=300

# iFind (同花顺 QuantAPI)
IFIND_ACCESS_KEY=your-ifind-access-key
IFIND_REFRESH_TOKEN=your-ifind-refresh-token

# ===== Redis (Phase 2+ 可选) =====
REDIS_URL=redis://localhost:6379/0

# ===== 通知 (Phase 11) =====
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
PUSHPLUS_ENDPOINT=https://www.pushplus.plus/send
WECHAT_WEBHOOK_URL=
