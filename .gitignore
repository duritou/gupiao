# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl

# Virtualenv
.venv/
venv/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Project
.env
data/sqlite/
data/cache/
data/logs/
data/exports/
!data/.gitkeep

# OS
.DS_Store
Thumbs.db

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# SQLite databases (runtime data, not source)
*.db
*.db-journal
*.db-wal
*.db-shm

# Deployment runtime state (release manifests never contain credentials)
runtime/

# Local dev convenience scripts
restart.ps1

# Third-party checkouts (nested git repo -- vendoring one would create a
# broken gitlink, and the code is never imported from here)
0713/

# Build and tooling artifacts
.skill-build/
.codex-remote-attachments/
vscode-ext/*.vsix

# Node dependencies (note: vscode-ext/node_modules is already tracked in this
# repo from before this rule existed -- ignoring it only stops NEW files being
# added; untracking the existing ones is a separate decision)
node_modules/

# Generated logs and reports
logs/
reports/
test-reports/

# Data root -- only its subdirectories were ignored before, so the top level
# (e.g. the 11 MB evidence_last_good.json) was still being tracked
data/*
!data/.gitkeep

# Stray files left by shell redirects and one-off debug runs
/=
.tmp_dailybrief.json
tmp_002156_tech.json
tmp_probe_debug*.db*
